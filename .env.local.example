# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gmail scan OAuth client (separate from Supabase's Google sign-in provider)
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/oauth/callback

# 32-byte base64 key, e.g. `openssl rand -base64 32`
GMAIL_TOKEN_ENCRYPTION_KEY=

# Resend (reminder emails) -- requires a verified sending domain for real users
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Shared secret Vercel Cron sends as a Bearer token
CRON_SECRET=

# Optional: enables LLM-based entity extraction fallback for Gmail detection
ANTHROPIC_API_KEY=
